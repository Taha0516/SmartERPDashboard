@* ──────────────────────────────────────────────────────────────
   ChatbotUI.razor — Static AI chatbot simulation component.
   Receives predefined Q&A entries via parameter and manages
   the chat message list entirely in Blazor state.
   ────────────────────────────────────────────────────────────── *@

<div class="chatbot-wrapper" aria-label="AI Support Chatbot">
    <div class="chatbot-header">
        <div class="chatbot-avatar">
            <i class="bi bi-robot"></i>
            <span class="chatbot-status-dot" title="Online"></span>
        </div>
        <div class="chatbot-header-info">
            <strong>@Loc.T("ERP Smart Assistant")</strong>
            <small>@Loc.T("Always online · AI-powered")</small>
        </div>
    </div>

    <div class="chatbot-messages" id="chatMessages">
        @foreach (var msg in _messages)
        {
            <div class="chat-bubble @(msg.IsBot ? "bot" : "user")">
                @if (msg.IsBot)
                {
                    <i class="bi bi-robot chat-bot-icon"></i>
                }
                <div class="chat-bubble__text">
                    @((MarkupString)FormatMessage(msg.Text))
                </div>
                <span class="chat-bubble__time">@msg.Timestamp.ToString("HH:mm")</span>
            </div>
        }
    </div>

    <div class="chatbot-quick-actions">
        <p class="quick-label">@Loc.T("Suggested questions:")</p>
        @foreach (var entry in Entries)
        {
            <button class="quick-btn"
                    @onclick="() => SendQuery(entry)"
                    aria-label="Ask: @entry.Query">
                @entry.Query
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public List<ChatbotEntry> Entries { get; set; } = default!;

    private readonly List<ChatMessage> _messages = new();

    protected override void OnInitialized()
    {
        Loc.OnLanguageChanged += StateHasChanged;
        if (!_messages.Any())
        {
            _messages.Add(new() { Text = Loc.T("👋 Hello! I'm your 24/7 AI assistant. How can I help you today?"), IsBot = true });
        }
    }

    public void Dispose()
    {
        Loc.OnLanguageChanged -= StateHasChanged;
    }

    private void SendQuery(ChatbotEntry entry)
    {
        _messages.Add(new() { Text = entry.Query, IsBot = false });
        _messages.Add(new() { Text = entry.Reply, IsBot = true });
    }

    /// <summary>Converts **bold** markdown syntax to HTML strong tags.</summary>
    private static string FormatMessage(string text)
        => System.Text.RegularExpressions.Regex.Replace(
               text,
               @"\*\*(.+?)\*\*",
               "<strong>$1</strong>");
}
