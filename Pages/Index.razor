@page "/"
@implements IDisposable
@inject IMockDataService DataService
@inject IJSRuntime JS
@inject IAuthService AuthService
@inject NavigationManager Nav

<PageTitle>Overview Dashboard — Smart ERP</PageTitle>

<section class="command-header">
    <div class="header-welcome">
        <div class="welcome-text">
            <h1>@Loc.T("Aramex Case Study"), @AuthService.Username!</h1>
            <p>@Loc.T("Digital Transformation Impact is up") <span class="trend-up">+14.2%</span> @Loc.T("for Aramex logistics.")</p>
        </div>
        
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="@Loc.T("Search metrics, tools, or research data...")" />
            <kbd>Ctrl + K</kbd>
        </div>
    </div>

    <div class="quick-actions">
        <button class="action-btn" @onclick='() => Nav.NavigateTo("roi-calculator")'>
            <i class="bi bi-calculator-fill"></i>
            <span>@Loc.T("New ROI Analysis")</span>
        </button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("operations-center")'>
            <i class="bi bi-gear-wide-connected"></i>
            <span>@Loc.T("Operations Status")</span>
        </button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("team-collaboration")'>
            <i class="bi bi-people-fill"></i>
            <span>@Loc.T("Collaborators")</span>
        </button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("tech-toolkit")'>
            <i class="bi bi-cpu-fill"></i>
            <span>@Loc.T("Toolkit")</span>
        </button>
    </div>
</section>

<!-- ── Toggle Switch ──────────────────────────────────────────── -->
<div class="toggle-section">
    <div class="toggle-container" role="group" aria-label="Technology State Toggle">
        <span class="toggle-label @(!_afterTech ? "active-label" : "")">@Loc.T("Before Tech")</span>
        <label class="toggle-switch" title="@(_afterTech ? "Switch to Before Tech" : "Switch to After Tech")">
            <input type="checkbox" id="techToggle" checked="@_afterTech" @onchange="OnToggleChanged" />
            <span class="toggle-thumb"></span>
        </label>
        <span class="toggle-label @(_afterTech ? "active-label" : "")">@Loc.T("After Tech")</span>
    </div>
    <p class="toggle-state-text">
        @Loc.T("Currently viewing:")&nbsp;
        <strong class="state-badge @(_afterTech ? "badge-after" : "badge-before")">
            @(_afterTech ? Loc.T("✅ Post-Digital Transformation") : Loc.T("⚠️ Pre-Digital Transformation"))
        </strong>
    </p>
</div>

<section class="kpi-section" aria-label="Key Performance Indicators">
    <h2 class="section-heading">@Loc.T("Key Performance Indicators")</h2>
    <div class="kpi-grid">
        @foreach (var metric in _kpiMetrics)
        {
            <KpiCard Metric="metric" />
        }
    </div>
</section>

<section class="chart-section" aria-label="Growth Comparison Chart">
    <div class="chart-card">
        <div class="chart-card__header">
            <div>
                <h2 class="chart-title">@Loc.T("Revenue Growth vs. Market Competitors")</h2>
                <p class="chart-subtitle">@Loc.T("Quarterly revenue index — Organization vs. Industry Average")</p>
            </div>
            <div class="chart-legend-chips">
                <span class="legend-chip chip-blue">@Loc.T("Our Organization")</span>
                <span class="legend-chip chip-orange">@Loc.T("Competitors")</span>
            </div>
        </div>
        <div class="chart-wrapper">
            <canvas id="growthChart" aria-label="Line chart showing revenue growth comparison"></canvas>
        </div>
    </div>
</section>

@code {
    private bool _afterTech = true;
    private bool _isRendered = false;
    private List<KpiMetric> _kpiMetrics = new();
    private ChartData _chartData = new();

    protected override void OnInitialized()
    {
        Loc.OnLanguageChanged += OnLanguageChanged;
        LoadData();
    }

    public void Dispose()
    {
        Loc.OnLanguageChanged -= OnLanguageChanged;
    }

    private async void OnLanguageChanged()
    {
        try 
        {
            LoadData();
            StateHasChanged();
            if (_isRendered)
            {
                await UpdateChart();
            }
        }
        catch { /* Ignore background errors during lang switch */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isRendered = true;
            await RenderChart();
        }
    }

    private void LoadData()
    {
        _kpiMetrics = DataService.GetKpiMetrics(_afterTech);
        _chartData  = DataService.GetGrowthChartData(_afterTech);
    }

    private async Task OnToggleChanged(ChangeEventArgs e)
    {
        _afterTech = (bool)(e.Value ?? false);
        LoadData();
        StateHasChanged();
        await UpdateChart();
    }

    private async Task RenderChart()
    {
        try 
        {
            await JS.InvokeVoidAsync("SmartERP.initChart", "growthChart", _chartData);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SmartERP] Chart Init Error: {ex.Message}");
        }
    }

    private async Task UpdateChart()
    {
        try 
        {
            if (_isRendered)
            {
                await JS.InvokeVoidAsync("SmartERP.updateChart", "growthChart", _chartData);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SmartERP] Chart Update Error: {ex.Message}");
        }
    }
}
