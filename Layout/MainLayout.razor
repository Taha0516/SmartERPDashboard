@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthService AuthService

<div class="erp-shell @(_isMenuOpen ? "menu-open" : "")" dir="@Loc.Dir">
    @if (_isMenuOpen)
    {
        <div class="menu-backdrop" @onclick="ToggleMenu" style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 90; backdrop-filter: blur(2px);"></div>
    }
    <header class="top-header">
        <button class="btn-menu-toggle d-mobile" @onclick="ToggleMenu">
            <i class="bi bi-list"></i>
        </button>
        <div style="flex: 1;"></div>
        <button class="btn-lang" @onclick="ToggleLanguage">
            <i class="bi bi-globe"></i> @(Loc.IsArabic ? "English" : "العربية")
        </button>
    </header>
    <NavMenu OnLinkClick="CloseMenu" />
    <main class="erp-main" id="main-content">
        <article class="erp-content">
            @Body
        </article>
    </main>
</div>

@code {
    private bool _isMenuOpen = false;

    protected override void OnInitialized()
    {
        Loc.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Loc.OnLanguageChanged -= StateHasChanged;
    }

    private void ToggleLanguage()
    {
        Loc.ToggleLanguage();
    }

    private void ToggleMenu()
    {
        _isMenuOpen = !_isMenuOpen;
    }

    private void CloseMenu()
    {
        if (_isMenuOpen)
        {
            _isMenuOpen = false;
            StateHasChanged();
        }
    }
}
